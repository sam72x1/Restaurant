# مستندات الصفقة الخام — مالية وشخصية.
# افتراضيًا لا تُرفع إلى GitHub. الأرقام المستخرجة منها تُسجَّل في model/inputs.json.
# إن كان المستودع خاصًا وتريد حفظ المستندات فيه، احذف كتلة data أدناه.
data/**
!data/**/
!data/**/.gitkeep

# سجل الأرقام المستخرجة ليس مستندًا خامًا — يُحفظ في المستودع
!data/extracted/**

reports/**
!reports/.gitkeep

__pycache__/
*.pyc
.DS_Store
